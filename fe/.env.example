# Copy thành .env.local và điền giá trị thật (file .env.local KHÔNG được commit)

# URL chính thức của website (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://tranduymedia.vn

# Địa chỉ backend (be/) — CHỈ server Next.js dùng để chuyển tiếp /api/v1/*, trình duyệt không thấy
BACKEND_URL=http://localhost:4000

# Cloud name Cloudinary — chỉ tên cloud, KHÔNG để API key / secret ở frontend
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

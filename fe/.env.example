# Copy thành .env.local và điền giá trị thật (file .env.local KHÔNG được commit)

# URL chính thức của website (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://tranduymedia.vn

# Địa chỉ backend (be/) — CHỈ server Next.js dùng để chuyển tiếp /api/v1/*, trình duyệt không thấy
BACKEND_URL=http://localhost:4000

# Cloud name Cloudinary — chỉ tên cloud, KHÔNG để API key / secret ở frontend
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Dung lượng video tối đa (MB) khi tải lên ở trang quản trị — khớp UPLOAD_MAX_VIDEO_MB ở be/.env và gói Cloudinary
# (miễn phí: 100MB). Bỏ trống = 100.
NEXT_PUBLIC_UPLOAD_MAX_VIDEO_MB=

# Nút "Đăng nhập nhanh" ở trang /login — CHỈ cho bản demo (ai mở trang cũng đăng nhập được quản trị).
# Đặt cả 2 biến (trùng ADMIN_ID / ADMIN_PASSWORD của backend) rồi build lại; bản chính thức: để trống / xoá.
NEXT_PUBLIC_DEMO_LOGIN_ID=
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=

# Copy thành .env và điền giá trị thật (file .env KHÔNG được commit)

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# error | warn | info | debug
LOG_LEVEL=info

# Origin được phép gọi API (frontend), phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,https://tranduymedia.vn

# Giới hạn chung: tối đa RATE_LIMIT_MAX request / IP trong RATE_LIMIT_WINDOW_MS (ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Số proxy tin cậy phía trước API (Next.js = 1; thêm Nginx/Cloudflare phía trước → 2). Backend KHÔNG nên mở ra Internet trực tiếp.
TRUST_PROXY=1

# ---------- MongoDB ----------
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=
MONGODB_DB_NAME=tranduymedia

# ---------- Cloudinary (ảnh & video) — lấy ở Cloudinary Console > Settings > API Keys ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc chứa file trên Cloudinary
CLOUDINARY_FOLDER=tranduymedia

# Giới hạn dung lượng upload (MB)
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=200

# ---------- Xác thực (JWT lưu trong cookie HttpOnly) ----------
# 2 chuỗi ngẫu nhiên KHÁC NHAU, ≥ 32 ký tự. Tạo bằng: npm run secret
# Để trống khi phát triển → tự sinh mỗi lần chạy (phải đăng nhập lại sau khi restart). Bắt buộc ở production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Thời hạn: access ngắn (15 phút), refresh dài (7 ngày, tự gia hạn khi dùng)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Số thiết bị đăng nhập cùng lúc tối đa
MAX_SESSIONS=5
# Cookie Secure (chỉ gửi qua HTTPS). Mặc định: bật ở production, tắt khi phát triển
# COOKIE_SECURE=true

# Gitignore gốc của monorepo — mỗi app còn có .gitignore riêng (fe/.gitignore, be/.gitignore)

# ---------- Dependencies ----------
node_modules/

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Editor / OS ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- Bảo mật ----------
*.pem
*.key
